# Cambia @baseUrl según cómo ejecutes el servidor:
# - PHP integrado: http://127.0.0.1:8000
# - Apache (XAMPP): http://localhost/scrum_microservices/back/retros_ms/public
@baseUrl = http://127.0.0.1:8000
@sprintId = 1
@retroId = 1
@accionId = 2

### =========================================
### SPRINTS (Juanjo)
### =========================================

### Listar todos los sprints
GET {{baseUrl}}/sprints
Accept: application/json

### Obtener un sprint por ID
GET {{baseUrl}}/sprints/{{sprintId}}
Accept: application/json

### Obtener el sprint anterior
GET {{baseUrl}}/sprints/{{sprintId}}/anterior
Accept: application/json

### Crear un sprint
POST {{baseUrl}}/sprints
Content-Type: application/json

{
  "nombre": "Sprint 1",
  "fecha_inicio": "2026-11-20",
  "fecha_fin": "2026-12-04"
}

### Actualizar un sprint
PUT {{baseUrl}}/sprints/{{sprintId}}
Content-Type: application/json

{
  "nombre": "Sprint 1 - Revisado",
  "fecha_inicio": "2026-11-20",
  "fecha_fin": "2026-12-06"
}

### Eliminar un sprint
DELETE {{baseUrl}}/sprints/{{sprintId}}
Accept: application/json

### =========================================
### RETRO ITEMS (David)
### =========================================

### Listar todos los ítems de retrospectiva
GET {{baseUrl}}/retros
Accept: application/json

### Listar ítems de retrospectiva de un sprint específico
GET {{baseUrl}}/sprints/{{sprintId}}/retros
Accept: application/json

### Listar solo las acciones de un sprint (seguimiento de sprint anterior)
GET {{baseUrl}}/sprints/{{sprintId}}/acciones
Accept: application/json

### Obtener un ítem de retrospectiva por ID
GET {{baseUrl}}/retros/{{retroId}}
Accept: application/json

### Crear un nuevo ítem de retrospectiva (logro)
POST {{baseUrl}}/retros
Content-Type: application/json

{
  "sprint_id": {{sprintId}},
  "categoria": "logro",
  "descripcion": "Se completaron todas las historias comprometidas del sprint."
}

### Crear un nuevo ítem de retrospectiva (accion con fecha de revisión)
POST {{baseUrl}}/retros
Content-Type: application/json

{
  "sprint_id": {{sprintId}},
  "categoria": "accion",
  "descripcion": "Automatizar pruebas de integración antes del cierre del sprint.",
  "fecha_revision": "2026-11-30"
}

### Crear un nuevo ítem de retrospectiva (impedimento)
POST {{baseUrl}}/retros
Content-Type: application/json

{
  "sprint_id": {{sprintId}},
  "categoria": "impedimento",
  "descripcion": "El servidor de staging estuvo caído 2 días."
}

### Actualizar un ítem de retrospectiva
PUT {{baseUrl}}/retros/{{retroId}}
Content-Type: application/json

{
  "categoria": "accion",
  "descripcion": "Mejorar cobertura de pruebas al 80%",
  "cumplida": false,
  "fecha_revision": "2026-12-10"
}

### Evaluar una acción (marcar como cumplida)
PATCH {{baseUrl}}/retros/{{accionId}}/evaluar
Content-Type: application/json

{
  "cumplida": true,
  "fecha_revision": "2026-11-20"
}

### Evaluar una acción (marcar como no cumplida; usa fecha actual por defecto)
PATCH {{baseUrl}}/retros/{{accionId}}/evaluar
Content-Type: application/json

{
  "cumplida": false
}

### Eliminar un ítem de retrospectiva
DELETE {{baseUrl}}/retros/{{retroId}}
Accept: application/json
